{
    "name": "silvershop/productcatalog",
    "description": "Provides the SilverShop Catalog admin for managing products and categories outside of the CMS site tree.",
    "license": "BSD-2-Clause",
    "type": "silverstripe-vendormodule",
    "homepage": "http://silvershop.github.io/",
    "minimum-stability": "dev",
    "prefer-stable": true,

    "support": {
        "source": "https://github.com/silvershop/silvershop-productcatalog",
        "issues": "https://github.com/silvershop/silvershop-productcatalog/issues"
    },

    "require": {
        "php": "^8.3",
        "silverstripe/cms": "^6",
        "silvershop/core": "^6.2"
    },

    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3"
    },

    "autoload": {
        "psr-4": {
            "SilverShop\\Admin\\": "src/Admin/",
            "SilverShop\\ProductCatalog\\Extension\\": "src/Extension/",
            "SilverShop\\ProductCatalog\\Tests\\": "tests/php/"
        }
    },

    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },

    "keywords": [
        "silverstripe",
        "silvershop",
        "shop",
        "catalog",
        "modeladmin"
    ],

    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-productcatalog/graphs/contributors"
        }
    ],

    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },

    "scripts": {
        "lint": "phpcs src/ tests/",
        "test": "phpunit"
    }
}
